# Create a local .env file and add your own Groq API key.
GROQ_API_KEY=your_groq_api_key_here

# Current Groq developer-tier recommendation. If your account has an active
# Llama model, set its model ID here instead.
GROQ_MODEL=openai/gpt-oss-20b

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
